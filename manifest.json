{
  "manifest_version": 3,
  "name": "AI Chatbot Summarizer",
  "version": "1.0",
  "description": "Summarize webpage content using Hugging Face NLP.",
  "permissions": ["activeTab", "storage", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "https://api-inference.huggingface.co/*"
  ]
}
